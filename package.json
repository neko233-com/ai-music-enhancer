{
  "name": "ai-music-enhancer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build crates/engine --target web --out-dir ../../web/src/wasm --release",
    "dev": "vite --config web/vite.config.ts --host 127.0.0.1",
    "build": "npm run wasm && npm run build:web",
    "build:web": "tsc --noEmit && vite build --config web/vite.config.ts && node scripts/build-sw.mjs",
    "preview": "vite preview --config web/vite.config.ts --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "check": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0",
    "wasm-pack": "0.15.0",
    "wrangler": "4.141.0"
  }
}
